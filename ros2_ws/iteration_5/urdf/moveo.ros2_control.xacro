<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="moveo">
	
    
		<ros2_control name="ros2ctl_iter4_system" type="system">
			<hardware>
				<plugin>moveo2_plugins/Moveo2HardwareInterface</plugin>
				<param name="i2c_bus">/dev/i2c-1</param>
				<param name="serial_device">/dev/ttyACM0</param>
				<param name="baud_rate">115200</param>
				<param name="timeout">1000</param>
			</hardware>
			<joint name="Joint_1">
				<param name="id">1</param>
				<param name="pin_pulse">52</param>
				<param name="pin_dir">50</param>
				<param name="direction">1</param>
				
				<param name="steps_per_revolution">32000</param>
				<param name="encoder_i2c_adress">0x40</param>
				<param name="initial_position_offset">-1.756</param>

				<command_interface name="velocity"/>
				<state_interface name="position"/>
				<state_interface name="velocity"/>
			</joint>
			<joint name="Joint_2">
				<param name="id">2</param>
				<param name="pin_pulse">48</param>
				<param name="pin_dir">46</param>
				<param name="direction">1</param>

				<param name="steps_per_revolution">16000</param>
				<param name="encoder_i2c_adress">0x44</param>
				<param name="initial_position_offset">0</param>
				
				<command_interface name="velocity"/>
				<state_interface name="position"/>
				<state_interface name="velocity"/>
			</joint>
			<joint name="Joint_3">
				<param name="id">3</param>
				<param name="pin_pulse">44</param>
				<param name="pin_dir">42</param>
				<param name="direction">1</param>

				<param name="steps_per_revolution">256</param>
				<param name="encoder_i2c_adress">0x48</param>
				<param name="initial_position_offset">0</param>
				
				<command_interface name="velocity"/>
				<state_interface name="position"/>
				<state_interface name="velocity"/>
			</joint>




		</ros2_control>
    

</robot>
